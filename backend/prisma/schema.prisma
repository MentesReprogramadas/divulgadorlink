generator client {
  provider = "prisma-client-js"
}

model OperationalMessage {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  occurrenceKey     String   @unique
  kind              String
  resourceId        String
  snapshotHash      String?
  payload           Json
  state             String   @default("PENDING")
  attempts          Int      @default(0)
  nextAttemptAt     DateTime @default(now())
  lockedAt          DateTime?
  providerMessageId String?
  lastErrorCode     String?
  expiresAt         DateTime?
  consumedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([tenantId, state, nextAttemptAt])
  @@index([tenantId, providerMessageId])
  @@index([kind, resourceId])
  @@map("operational_messages")
}

model EvolutionReceipt {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instance          String
  providerMessageId String
  sender            String
  reference         String
  decision          String
  reason            String?
  state             String   @default("PENDING")
  resultCode        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@unique([instance, providerMessageId])
  @@index([state, createdAt])
  @@map("evolution_receipts")
}

model EvolutionOperator {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phone     String
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  @@unique([tenantId, phone])
  @@map("evolution_operators")
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  affiliateImages AffiliateImage[]
  affiliateSegmentInstances AffiliateSegmentInstance[]
  affiliateInstances AffiliateInstance[]
  affiliateSegments AffiliateSegment[]
  affiliateGroups AffiliateGroup[]
  affiliateOffers AffiliateOffer[]
  affiliateBroadcasts AffiliateBroadcast[]
  affiliateScheduleBatches AffiliateScheduleBatch[]
  affiliateDeliveries AffiliateDelivery[]
  affiliateConnections AffiliateConnection[]
  affiliatePriceObservations AffiliatePriceObservation[]
  id              String           @id @default(cuid())
  host            String           @unique
  name            String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  users           User[]
  networks        Network[]
  niches          Niche[]
  promotionPrices PromotionPrice[]
  promotionOffers PromotionOffer[]
  configs         Config[]
  auditLogs       AuditLog[]
  links           Link[]
  blocklistTerms  BlocklistTerm[]
  moderationCases ModerationCase[]
  promotions      Promotion[]
  embeddingJobs   EmbeddingJob[]
  orders          Order[]
  analyticsEvents AnalyticsEvent[]
  operationalMessages OperationalMessage[]
  evolutionReceipts EvolutionReceipt[]
  evolutionOperators EvolutionOperator[]
  @@map("tenants")
  promotionInvestments PromotionInvestment[]
  linkReports LinkReport[]
  linkAvailability LinkAvailability[]
  urlRevisions UrlRevision[]
  promotionPauses PromotionPause[]
  profiles Profile[]
  searchObservations SearchObservation[]
  profilePlans ProfilePlan[]
  profileBillingAccounts ProfileBillingAccount[]
  profileBillingSettings ProfileBillingSettings?

}

model AffiliateInstance {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name String
  secret String?
  ownerPhone String?
  nextSendAt DateTime @default(now())
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  groups AffiliateGroup[]
  segments AffiliateSegment[]
  segmentLinks AffiliateSegmentInstance[]
  deliveries AffiliateDelivery[]
  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@map("affiliate_instances")
}

model AffiliateSegment {
  conversionIntents AffiliateConversionIntent[]
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name String
  groupName String?
  slug String
  description String @default("")
  imageUrl String?
  capacity Int @default(1024)
  autoExpand Boolean @default(false)
  joinMode String @default("REDIRECT")
  groupPolicyEnabled Boolean @default(false)
  groupDisappearingSeconds Int @default(604800)
  groupJoinApproval Boolean @default(true)
  groupAutoApproveDelaySeconds Int @default(10)
  instanceId String?
  instance AffiliateInstance? @relation(fields: [instanceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  enabled Boolean @default(true)
  nextSequence Int @default(1)
  provisionState String @default("IDLE")
  provisionStartedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  groups AffiliateGroup[]
  offers AffiliateOffer[]
  discovery AffiliateDiscovery?
  discoveryPages AffiliateDiscoveryPage[]
  productDecisions AffiliateProductDecision[]
  instanceLinks AffiliateSegmentInstance[]
  inviteMetrics AffiliateInviteMetrics?
  inviteEvents AffiliateInviteEvent[]
  @@unique([id, tenantId])
  @@unique([tenantId, slug])
  @@map("affiliate_segments")
}

model AffiliateConversionIntent {
  id String @id @default(cuid())
  tenantId String
  segmentId String
  segment AffiliateSegment @relation(fields: [segmentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  phoneHash String
  encryptedMeta String?
  consentVersion String
  consentAt DateTime
  expiresAt DateTime
  confirmedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  outboxes AffiliateConversionOutbox[]
  @@unique([tenantId, segmentId, phoneHash])
  @@index([expiresAt])
  @@map("affiliate_conversion_intents")
}

model AffiliateConversionOutbox {
  groupId String?
  kind String
  id String @id
  intentId String
  intent AffiliateConversionIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  state String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseToken String?
  leaseExpiresAt DateTime?
  occurredAt DateTime
  createdAt DateTime @default(now())
  @@unique([intentId, kind])
  @@index([state, nextAttemptAt])
  @@map("affiliate_conversion_outbox")
}

model AffiliateInviteMetrics {
  segmentId String @id
  tenantId String
  segment AffiliateSegment @relation(fields: [segmentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  views Int @default(0)
  buttonClicks Int @default(0)
  automaticRedirects Int @default(0)
  buttonRedirects Int @default(0)
  createdAt DateTime @default(now())
  @@unique([segmentId, tenantId])
  @@map("affiliate_invite_metrics")
}

model AffiliateInviteEvent {
  tenantId String
  segmentId String
  eventId String @db.Uuid
  kind String
  createdAt DateTime @default(now())
  segment AffiliateSegment @relation(fields: [segmentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  @@id([tenantId, segmentId, eventId, kind])
  @@index([createdAt])
  @@map("affiliate_invite_events")
}

model AffiliateDiscovery {
  provider String @default("MERCADO_LIVRE")
  segmentId String @id
  tenantId String
  segment AffiliateSegment @relation(fields: [segmentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  enabled Boolean @default(true)
  terms String[] @default([])
  cursor Int @default(0)
  expandedTerms String[] @default([])
  pageCursors Json @default("{}")
  requestedTerm String?
  requestedPage Int?
  runStartedAt DateTime?
  durationMs Int?
  productsJson Json @default("[]")
  countsJson Json?
  status String @default("QUEUED")
  error String?
  checkedAt DateTime?
  nextRunAt DateTime @default(now())
  leaseToken String?
  leaseExpiresAt DateTime?
  configVersion Int @default(0)
  @@unique([segmentId, tenantId])
  @@index([enabled, nextRunAt])
  @@map("affiliate_discoveries")
}

model AffiliateDiscoveryPage {
  tenantId String
  segmentId String
  term String
  page Int
  productsJson Json
  countsJson Json
  total Int
  checkedAt DateTime @default(now())
  segment AffiliateSegment @relation(fields: [segmentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  @@id([tenantId, segmentId, term, page])
  @@map("affiliate_discovery_pages")
}

model AffiliatePriceObservation {
  tenantId String
  itemId String
  day DateTime @db.Date
  priceCents Int
  observedAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@id([tenantId, itemId, day])
  @@index([tenantId, itemId, observedAt])
  @@map("affiliate_price_observations")
}

model AffiliateProductDecision {
  tenantId String
  segmentId String
  itemId String
  decision String
  reason String
  actorId String?
  broadcastId String?
  priceCents Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  segment AffiliateSegment @relation(fields: [segmentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  @@id([tenantId, segmentId, itemId])
  @@map("affiliate_product_decisions")
}

model AffiliateScheduleBatch {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  segmentId String
  actorId String
  idempotencyKey String
  status String @default("BUILDING")
  mode String
  source String @default("RULES")
  config Json
  groupHash String
  groups Json
  expiresAt DateTime
  leaseToken String?
  leaseExpiresAt DateTime?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entries AffiliateScheduledOffer[]
  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, segmentId, createdAt])
  @@map("affiliate_schedule_batches")
}

model AffiliateScheduledOffer {
  id String @id @default(cuid())
  tenantId String
  batchId String
  batch AffiliateScheduleBatch @relation(fields: [batchId, tenantId], references: [id, tenantId], onDelete: Cascade)
  itemId String
  position Int
  scheduledAt DateTime
  state String @default("BUILDING")
  snapshot Json
  broadcastId String?
  error String?
  leaseToken String?
  leaseExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([batchId, itemId])
  @@index([state, scheduledAt])
  @@index([tenantId, itemId])
  @@map("affiliate_scheduled_offers")
}

model AffiliateImage {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bytes Bytes
  createdAt DateTime @default(now())
  @@index([tenantId])
}

model AffiliateSegmentInstance {
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  segmentId String
  segment AffiliateSegment @relation(fields: [segmentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  instanceId String
  instance AffiliateInstance @relation(fields: [instanceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  lastUsedAt DateTime @default(dbgenerated("'1970-01-01 00:00:00'::timestamp without time zone"))
  @@id([segmentId, instanceId])
  @@index([instanceId, tenantId])
  @@map("affiliate_segment_instances")
}

model AffiliateGroup {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  segmentId String
  segment AffiliateSegment @relation(fields: [segmentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  instanceId String
  instance AffiliateInstance @relation(fields: [instanceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  jid String
  name String
  sequence Int
  participantCount Int @default(0)
  capacity Int @default(1024)
  inviteUrl String?
  enabled Boolean @default(true)
  syncedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveries AffiliateDelivery[]
  membershipTracking AffiliateMembershipTracking?
  groupPolicyState String @default("PENDING")
  groupPolicyErrorCode String?
  groupPolicyAppliedHash String?
  groupDescriptionAppliedHash String?
  groupPolicyNextRunAt DateTime @default(now())
  groupPolicyLeaseToken String?
  groupPolicyLeaseExpiresAt DateTime?
  admissions AffiliateGroupAdmission[]
  @@index([enabled, groupPolicyNextRunAt], map: "affiliate_groups_policy_due_idx")
  @@unique([id, tenantId])
  @@unique([tenantId, jid])
  @@unique([segmentId, sequence])
  @@map("affiliate_groups")
}

model AffiliateMembershipTracking {
  groupId String @id
  tenantId String
  group AffiliateGroup @relation(fields: [groupId, tenantId], references: [id, tenantId], onDelete: Cascade)
  status String @default("BASELINING")
  baselineAt DateTime?
  expiresAt DateTime?
  startedAt DateTime @default(now())
  receivedDuringBaseline Int @default(0)
  lastReceivedAt DateTime?
  lastErrorCode String?
  states AffiliateMembershipState[]
  days AffiliateMembershipDaily[]
  @@unique([groupId, tenantId])
  @@index([expiresAt])
  @@map("affiliate_membership_tracking")
}

model AffiliateMembershipState {
  tenantId String
  groupId String
  identityHash String @db.Char(64)
  present Boolean
  lastEventAt DateTime
  tracking AffiliateMembershipTracking @relation(fields: [groupId, tenantId], references: [groupId, tenantId], onDelete: Cascade)
  @@id([tenantId, groupId, identityHash])
  @@map("affiliate_membership_states")
}

model AffiliateMembershipDaily {
  tenantId String
  groupId String
  day DateTime @db.Date
  joins Int @default(0)
  leaves Int @default(0)
  rejoins Int @default(0)
  staleEvents Int @default(0)
  tracking AffiliateMembershipTracking @relation(fields: [groupId, tenantId], references: [groupId, tenantId], onDelete: Cascade)
  @@id([tenantId, groupId, day])
  @@map("affiliate_membership_daily")
}

model AffiliateOffer {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  segmentId String
  segment AffiliateSegment @relation(fields: [segmentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  title String
  itemId String?
  productUrl String
  affiliateUrl String
  priceCents Int
  oldPriceCents Int?
  reportedDiscountPercent Int?
  oldPriceEstimated Boolean @default(false)
  imageUrl String?
  note String @default("")
  status String @default("DRAFT")
  checkedAt DateTime @default(now())
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  broadcasts AffiliateBroadcast[]
  @@index([tenantId, segmentId, itemId])
  @@unique([id, tenantId])
  @@index([tenantId, createdAt])
  @@map("affiliate_offers")
}

model AffiliateBroadcast {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  segmentId String
  offerId String
  offer AffiliateOffer @relation(fields: [offerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  idempotencyKey String
  message String
  offerUpdatedAt DateTime
  imageUrl String?
  productSnapshot Json?
  scheduledAt DateTime @default(now())
  createdAt DateTime @default(now())
  deliveries AffiliateDelivery[]
  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@map("affiliate_broadcasts")
}

model AffiliateDelivery {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  broadcastId String
  broadcast AffiliateBroadcast @relation(fields: [broadcastId, tenantId], references: [id, tenantId], onDelete: Restrict)
  groupId String
  group AffiliateGroup @relation(fields: [groupId, tenantId], references: [id, tenantId], onDelete: Restrict)
  state String @default("PENDING")
  providerMessageId String?
  sentViaInstanceId String?
  sentViaInstance AffiliateInstance? @relation(fields: [sentViaInstanceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  errorCode String?
  lockedAt DateTime?
  nextAttemptAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([broadcastId, groupId])
  @@index([state, nextAttemptAt])
  @@index([tenantId, createdAt])
  @@map("affiliate_deliveries")
}

model AffiliateConnection {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider String
  credentials String
  status String @default("CONFIGURED")
  oauthState String?
  oauthVerifier String?
  oauthExpiresAt DateTime?
  updatedAt DateTime @updatedAt
  @@unique([tenantId, provider])
  @@map("affiliate_connections")
}

model User {
 agencyWorkspace AgencyWorkspace?
 agencyAssignments AgencyAccessRequest[]
 sentProfileTransfers AgencyProfileTransfer[]
  webhookEndpoints WebhookEndpoint[]
  outboundEvents OutboundEvent[]
  followedProfiles ProfileFollow[]
 profileSuggestions ProfileSuggestion[]
 suggestionUsage ProfileSuggestionUsage[]
 workspaceOwnedMembers WorkspaceMembership[] @relation("WorkspaceOwner")
 workspaceJoinedMembers WorkspaceMembership[] @relation("WorkspaceMember")
 workspaceInvitations WorkspaceInvitation[] @relation("WorkspaceInvitationOwner")
 profileMemberships ProfileMembership[]
 contentReviews ContentReview[]
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  name         String
  passwordHash String
  role         UserRole  @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  favorites Favorite[]
  collections Collection[]
  profiles Profile[]
  profileBillingAccounts ProfileBillingAccount[]
  profileAssets ProfileAsset[]
  redirectHandles RedirectHandle[]
  @@unique([id, tenantId], map: "users_id_tenantid_key")
  identifiers  UserIdentifier[]
  links        Link[]
  orders       Order[]
  nicheFollows NicheFollow[]
  nicheDigestBatches NicheDigestBatch[]
  emailDigest Boolean @default(false)
  digestFrequency String @default("WEEKLY") @db.VarChar(8)
  nextDigestAt DateTime?
  emailRenewal Boolean @default(false)
  notificationVersion Int @default(0)
  acquisitionTouch AcquisitionTouch?
  evolutionOperators EvolutionOperator[]
  @@index([tenantId])
  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

model UserIdentifier {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id])
  tenantId          String
  kind              IdentifierKind
  normalizedValue   String
  confirmedAt       DateTime?
  replacedAt        DateTime?
  createdAt         DateTime           @default(now())
  verificationCodes VerificationCode[]
  @@unique([tenantId, kind, normalizedValue])
  @@index([userId])
  @@map("user_identifiers")
}

enum IdentifierKind {
  EMAIL
  PHONE
}

model VerificationCode {
  id               String         @id @default(cuid())
  userId           String
  userIdentifierId String
  userIdentifier   UserIdentifier @relation(fields: [userIdentifierId], references: [id])
  kind             IdentifierKind
  codeHash         String
  expiresAt        DateTime
  attempts         Int            @default(0)
  isResend         Boolean        @default(false)
  createdAt        DateTime       @default(now())
  @@index([userId, kind, createdAt])
  @@index([userIdentifierId, createdAt])
  @@map("verification_codes")
}

enum PromotionProductCode {
  SEARCH
  NICHE
  HOME
  SEARCH_NICHE
  SEARCH_NICHE_HOME
}

model PromotionPrice {
  id            String               @id @default(cuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  productCode   PromotionProductCode
  durationDays  Int
  amountCents   Int
  currency      String               @default("BRL")
  effectiveFrom DateTime             @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  @@unique([tenantId, productCode, durationDays])
  @@index([tenantId])
  @@map("promotion_prices")
}

model PromotionOffer {
  id          String               @id @default(cuid())
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  productCode PromotionProductCode
  name        String
  sortOrder   Int
  featured    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  @@unique([tenantId, productCode])
  @@index([tenantId, sortOrder])
  @@map("promotion_offers")
}

model Config {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("configs")
}

model Network {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String
  slug          String
  knownHosts    String[]
  isPublicFacet Boolean  @default(true)
  summary       String?
  requiresAge   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  links         Link[]
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("networks")
}

model Niche {
  discoveredProfiles ProfileDiscovery[]
  followers NicheFollow[]
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String
  slug          String
  requiresAge   Boolean  @default(false)
  isPublicFacet Boolean  @default(true)
  summary       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  links         Link[]
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@unique([id, tenantId], map: "niches_id_tenant_key")
  @@map("niches")
}

enum LinkStatus {
  DRAFT
  PENDING_MODERATION
  PRE_REJECTED
  PUBLISHED
  UNAVAILABLE
}

model Link {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  ownerId      String?
  owner        User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  canonicalUrl String
  name         String
  description  String
  networkId    String
  network      Network    @relation(fields: [networkId], references: [id])
  nicheId      String
  niche        Niche      @relation(fields: [nicheId], references: [id])
  otherNote    String?
  cityId       String?
  languageTag  String?
  modality     String?
  discoveryVersion Int @default(0)
  mediaVersion Int @default(0)
  media LinkMediaAsset[]
  status              LinkStatus
  occupiesSlot        Boolean    @default(true)
  everPublished       Boolean    @default(false)
  approvedName        String?
  approvedDescription String?
  acquisitionSource   String?
  acquisitionMedium   String?
  acquisitionCampaign String?
  acquisitionContent  String?
  acquisitionTerm     String?
  embedding           Unsupported("vector(1536)")?
  embeddingState      EmbeddingState @default(ABSENT)
  createdAt           DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  moderationCases ModerationCase[]
  promotions      Promotion[]
  embeddingJobs   EmbeddingJob[]
  orders          Order[]
  favorites Favorite[]
  reports         LinkReport[]
  profileItems ProfileItem[]
    availability    LinkAvailability?
    urlRevisions    UrlRevision[]
  @@unique([id, tenantId])
  @@index([tenantId, ownerId, status])
  @@index([tenantId, status, id])
  digestReceipts NicheDigestReceipt[]
  @@map("links")
}

model LinkMediaAsset {
  id String @id @default(cuid())
  tenantId String
  linkId String
  link Link @relation(fields: [linkId, tenantId], references: [id, tenantId], onDelete: Cascade)
  kind String
  status String @default("PENDING")
  bytes Bytes
  alt String?
  revision Int
  createdAt DateTime @default(now())
  @@index([tenantId, status, createdAt])
  @@map("link_media_assets")
}

enum EmbeddingState {
  ABSENT
  PENDING
  READY
  FAILED
}

enum EmbeddingJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

