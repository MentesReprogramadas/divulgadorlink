generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id              String           @id @default(cuid())
  host            String           @unique
  name            String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  users           User[]
  networks        Network[]
  niches          Niche[]
  promotionPrices PromotionPrice[]
  promotionOffers PromotionOffer[]
  configs         Config[]
  auditLogs       AuditLog[]
  links           Link[]
  blocklistTerms  BlocklistTerm[]
  moderationCases ModerationCase[]
  promotions      Promotion[]
  embeddingJobs   EmbeddingJob[]
  orders          Order[]
  analyticsEvents AnalyticsEvent[]
  @@map("tenants")
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  name         String
  passwordHash String
  role         UserRole  @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  identifiers  UserIdentifier[]
  links        Link[]
  orders       Order[]
  acquisitionTouch AcquisitionTouch?
  @@index([tenantId])
  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

model UserIdentifier {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id])
  tenantId          String
  kind              IdentifierKind
  normalizedValue   String
  confirmedAt       DateTime?
  replacedAt        DateTime?
  createdAt         DateTime           @default(now())
  verificationCodes VerificationCode[]
  @@unique([tenantId, kind, normalizedValue])
  @@index([userId])
  @@map("user_identifiers")
}

enum IdentifierKind {
  EMAIL
  PHONE
}

model VerificationCode {
  id               String         @id @default(cuid())
  userId           String
  userIdentifierId String
  userIdentifier   UserIdentifier @relation(fields: [userIdentifierId], references: [id])
  kind             IdentifierKind
  codeHash         String
  expiresAt        DateTime
  attempts         Int            @default(0)
  isResend         Boolean        @default(false)
  createdAt        DateTime       @default(now())
  @@index([userId, kind, createdAt])
  @@index([userIdentifierId, createdAt])
  @@map("verification_codes")
}

enum PromotionProductCode {
  SEARCH
  NICHE
  HOME
  SEARCH_NICHE
  SEARCH_NICHE_HOME
}

model PromotionPrice {
  id            String               @id @default(cuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  productCode   PromotionProductCode
  durationDays  Int
  amountCents   Int
  currency      String               @default("BRL")
  effectiveFrom DateTime             @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  @@unique([tenantId, productCode, durationDays])
  @@index([tenantId])
  @@map("promotion_prices")
}

model PromotionOffer {
  id          String               @id @default(cuid())
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  productCode PromotionProductCode
  name        String
  sortOrder   Int
  featured    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  @@unique([tenantId, productCode])
  @@index([tenantId, sortOrder])
  @@map("promotion_offers")
}

model Config {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("configs")
}

model Network {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String
  slug          String
  knownHosts    String[]
  isPublicFacet Boolean  @default(true)
  summary       String?
  requiresAge   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  links         Link[]
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("networks")
}

model Niche {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String
  slug          String
  requiresAge   Boolean  @default(false)
  isPublicFacet Boolean  @default(true)
  summary       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  links         Link[]
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("niches")
}

enum LinkStatus {
  DRAFT
  PENDING_MODERATION
  PRE_REJECTED
  PUBLISHED
  UNAVAILABLE
}

model Link {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  ownerId      String?
  owner        User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  canonicalUrl String
  name         String
  description  String
  networkId    String
  network      Network    @relation(fields: [networkId], references: [id])
  nicheId      String
  niche        Niche      @relation(fields: [nicheId], references: [id])
  otherNote    String?
  status              LinkStatus
  occupiesSlot        Boolean    @default(true)
  everPublished       Boolean    @default(false)
  approvedName        String?
  approvedDescription String?
  acquisitionSource   String?
  acquisitionMedium   String?
  acquisitionCampaign String?
  acquisitionContent  String?
  acquisitionTerm     String?
  embedding           Unsupported("vector(1536)")?
  embeddingState      EmbeddingState @default(ABSENT)
  createdAt           DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  moderationCases ModerationCase[]
  promotions      Promotion[]
  embeddingJobs   EmbeddingJob[]
  orders          Order[]
  @@index([tenantId, ownerId, status])
  @@index([tenantId, status, id])
  @@map("links")
}

enum EmbeddingState {
  ABSENT
  PENDING
  READY
  FAILED
}

enum EmbeddingJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model EmbeddingJob {
  id                String             @id @default(cuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  linkId            String
  link              Link               @relation(fields: [linkId], references: [id])
  status            EmbeddingJobStatus @default(PENDING)
  attempts          Int                @default(0)
  nextAttemptAt     DateTime           @default(now())
  lastError         String?
  snapshotName      String
  snapshotDescription String
  snapshotNetworkId String
  snapshotNicheId   String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  @@index([status, nextAttemptAt])
  @@index([linkId])
  @@map("embedding_jobs")
}

enum PromotionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PromotionSurface {
  SEARCH
  NICHE
  HOME
}

model Promotion {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  linkId      String
  link        Link            @relation(fields: [linkId], references: [id])
  status      PromotionStatus
  surface     PromotionSurface
  activatedAt DateTime
  expiresAt   DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  @@index([tenantId, linkId, status])
  @@index([surface, status, activatedAt])
  @@map("promotions")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  EXPIRED
  PAID_LATE
  REFUND_PENDING
  REFUNDED
  REFUND_FAILED
}

enum PaymentMethod {
  PIX
  CARD
}

enum SurfaceHold {
  PENDING_PAYMENT
  RELEASED
}

model Order {
  id                   String               @id @default(cuid())
  tenantId             String
  tenant               Tenant               @relation(fields: [tenantId], references: [id])
  userId               String?
  user                 User?                @relation(fields: [userId], references: [id])
  linkId               String
  link                 Link                 @relation(fields: [linkId], references: [id])
  status               OrderStatus
  method               PaymentMethod
  productCode          PromotionProductCode
  durationDays         Int
  amountCents          Int
  savingsCents         Int
  pixExpiresAt         DateTime?
  gatewayChargeId      String?
  brCode               String?
  refundCorrelationId  String?
  refundAttempts       Int                  @default(0)
  refundErrors         Json                 @default("[]")
  refundIds            Json                 @default("[]")
  idempotencyKey       String?
  renewal              Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  surfaces             OrderSurface[]
  payments             Payment[]
  events               OrderEvent[]
  @@unique([tenantId, userId, idempotencyKey])
  @@index([tenantId, linkId, status])
  @@map("orders")
}

model OrderSurface {
  id        String           @id @default(cuid())
  orderId   String
  order     Order            @relation(fields: [orderId], references: [id])
  linkId    String
  surface   PromotionSurface
  hold      SurfaceHold      @default(PENDING_PAYMENT)
  @@index([orderId])
  @@map("order_surfaces")
}

model Payment {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  provider    String
  externalId  String?
  amountCents Int
  status      String
  createdAt   DateTime @default(now())
  @@index([orderId])
  @@map("payments")
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  eventId   String
  createdAt DateTime @default(now())
  @@unique([orderId, eventId])
  @@map("order_events")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  sessionId String
  linkId    String
  surface   String
  day       DateTime @db.Date
  kind      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([sessionId, linkId, surface, day, kind])
  @@index([tenantId, day])
  @@index([tenantId, linkId, day])
  @@map("analytics_events")
}

model ModerationCase {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  linkId     String
  link       Link      @relation(fields: [linkId], references: [id])
  appealText String?
  appealedAt DateTime?
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  @@index([tenantId])
  @@index([linkId, closedAt])
  @@map("moderation_cases")
}

model BlocklistTerm {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  term      String
  createdAt DateTime @default(now())
  @@index([tenantId])
  @@map("blocklist_terms")
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  requestId  String?
  createdAt  DateTime @default(now())
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model AcquisitionTouch {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source      String
  medium      String
  campaign    String
  content     String
  term        String
  landingPath String
  createdAt   DateTime @default(now())
  @@index([tenantId, campaign])
  @@map("acquisition_touches")
}

model FunnelEvent {
  id        String   @id @default(cuid())
  tenantId  String
  eventId   String
  name      String
  userId    String?
  linkId    String?
  createdAt DateTime @default(now())
  @@unique([tenantId, eventId])
  @@index([tenantId, name, createdAt])
  @@map("funnel_events")
}

model SiteTrafficDaily {
  id       String   @id @default(cuid())
  tenantId String
  day      DateTime @db.Date
  path     String
  source   String   @default("")
  medium   String   @default("")
  campaign String   @default("")
  views    Int      @default(0)
  entries  Int      @default(0)
  @@unique([tenantId, day, path, source, medium, campaign])
  @@index([tenantId, day])
  @@map("site_traffic_daily")
}

model ConsentDaily {
  id       String   @id @default(cuid())
  tenantId String
  day      DateTime @db.Date
  choice   String
  count    Int      @default(0)
  @@unique([tenantId, day, choice])
  @@map("consent_daily")
}
