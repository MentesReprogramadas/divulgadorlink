# dev | test | production
# No Railway o valor tem de ser production. String vazia nas opcionais é tratada como ausente.
# Não defina PIX_EXPIRATION_SECONDS em production: a API recusa subir.
NODE_ENV=dev
PORT=3333
HOST=0.0.0.0

# Portas batem com o docker-compose.yml (postgres 5437, redis 6377)
DATABASE_URL=postgresql://divulgador:divulgador@localhost:5437/divulgador
REDIS_URL=redis://localhost:6377

# Mínimo 16 caracteres. Gere um valor aleatório: openssl rand -base64 48
JWT_SECRET=

# Observabilidade (HyperDX autohospedado). Sem chave, sem endpoint ou com o coletor
# da nuvem (in-otel.hyperdx.io) a API só loga no stdout.
# O endpoint é o coletor OTLP HTTP, porta 4318, não a URL da interface.
# railway.internal só resolve dentro do projeto Railway do HyperDX. Fora dele use o domínio HTTPS público do coletor.
# Amostragem fica em 100% de propósito: um ratio também descartaria os 5xx.
# O worker usa o mesmo nome com sufixo -worker.
# HDX_STARTUP_LOGS=false cala o banner. Ele aponta para www.hyperdx.io, que não é esta instância.
HDX_API_KEY=
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.up.railway.app
HDX_SERVICE_NAME=divulgador-links-api

# Stripe — opcional
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Assinaturas de páginas: independentes dos destaques. Desligado por padrão.
# Use uma chave restrita própria e um endpoint de webhook próprio.
# Desligar novas vendas não cancela os contratos existentes nem seus webhooks.
PROFILE_BILLING_SALES_ENABLED=0
STRIPE_BILLING_SECRET_KEY=
STRIPE_BILLING_WEBHOOK_SECRET=

# Woovi / Pix — opcional
WOOVI_APP_ID=
# Validada como URL: vazia quebra o boot, então mantenha comentada se não usar
# WOOVI_API_BASE_URL=
WOOVI_WEBHOOK_PUBLIC_KEY=

# OpenAI (embeddings / propostas de texto) — opcional
OPENAI_API_KEY=

# Só dev/test: TTL do Pix em segundos, inteiro de 3 a 1800. Padrão 1800.
# Em production a API e o worker recusam subir se esta variável existir.
# PIX_EXPIRATION_SECONDS=

# 1 = expõe a caixa de confirmação de identificador em dev (ignorado em production)
CONFIRMATION_INBOX=

# Resend. Sem a chave, produção recusa o OTP. Fora de produção o código cai no inbox de teste.
# O remetente precisa ser um domínio verificado no Resend.
# RESEND_API_KEY=
# EMAIL_FROM=Tem Link Aqui <nao-responda@seudominio.com>
# APP_PUBLIC_URL=https://seudominio.com
# EMAIL_BRAND_NAME=Tem Link Aqui

# 1 = guarda o HTML enviado em dev (ignorado em production). A suíte E2E lê essa caixa.
# EMAIL_OUTBOX=

# Só para specs de integração com Postgres real (rodar com PG_SPECS=1)
# ANALYTICS_DATABASE_URL=
# CHECKOUT_DATABASE_URL=

# F07: enable only after the additive migration and compatible API/worker are deployed.
AVAILABILITY_ENABLED=0
AVAILABILITY_INTERVAL_MINUTES=360
AVAILABILITY_FAILURE_THRESHOLD=3
AVAILABILITY_RETRY_MINUTES=30
AVAILABILITY_HOST_INTERVAL_SECONDS=60

# F02: delivery opt-in; keep disabled until controlled rollout
RENEWAL_REMINDERS_ENABLED=0

# F05: opt-in e-mail digest worker (disabled until operational activation)
NICHE_DIGESTS_ENABLED=0

# F25 uses OPENAI_API_KEY only after an explicit generation action.
# Model/rate/limits are versioned in SUGGESTION_POLICY; no new provider key is required.

# F10: raízes públicas controladas pela plataforma. Mesmo JSON no frontend/API.
# Default desabilitado. Só configurar após DNS/proxy/certificado de staging validados.
# Exemplo: {"paginas.temlinkaqui.com":"temlinkaqui.com"}
PROFILE_HOST_BASES={}

# F10: inventário ao vivo da infraestrutura. Sem configuração/falha: bloquear subdomínios.
# Token somente no backend, com leitura de todos os recursos/servidores relevantes.
COOLIFY_API_URL=https://coolify.temlinkaqui.com
COOLIFY_API_TOKEN=
# UUID da aplicação frontend que serve exclusivamente o wildcard das páginas.
COOLIFY_PROFILE_ROUTER_UUID=

# Cloudflare: token restrito a DNS:Read e Zone:Read nas zonas relevantes.
CLOUDFLARE_DNS_API_TOKEN=
# Raiz de páginas => Zone ID autoritativo, 32 caracteres hexadecimais.
# Ex.: {"paginas.temlinkaqui.com":"<zone-id>"}
PROFILE_HOST_DNS_ZONES={}
## F30: chave AES-256 em base64 (32 bytes). Somente backend/worker; nunca NEXT_PUBLIC.
WEBHOOK_ENCRYPTION_KEY=
