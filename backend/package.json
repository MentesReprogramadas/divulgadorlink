{
  "name": "divulgador-links-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node build/server.js",
    "worker": "tsx src/worker.ts",
    "build": "tsup src --out-dir build",
    "test": "vitest run",
    "test:pg": "vitest run --no-file-parallelism src/http/analytics.pg.spec.ts src/http/checkout.pg.spec.ts src/http/catalog.pg.spec.ts src/use-cases/@Links/text-proposed-worker.pg.spec.ts src/use-cases/@Search/hybrid-search.pg.spec.ts src/http/controllers/@Search/search-http.pg.spec.ts",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:demo": "npx tsx prisma/demo-seed.ts",
    "db:push": "prisma db push",
    "db:pull": "prisma db pull",
    "db:reset": "prisma migrate reset",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/jwt": "^10.2.2",
    "@hyperdx/node-opentelemetry": "^0.11.0",
    "@prisma/client": "6.0.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.58.5",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "ioredis": "5.11.1",
    "prisma": "6.0.1",
    "stripe": "^18.5.0",
    "zod": "^3.24.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/propagator-b3": "2.11.0",
    "@opentelemetry/propagator-jaeger": "2.11.0"
  },
  "allowScripts": {
    "@prisma/client@6.0.1": true,
    "@prisma/engines@6.0.1": true,
    "prisma@6.0.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.2": true,
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.4": true,
    "protobufjs@7.6.6": true
  }
}
