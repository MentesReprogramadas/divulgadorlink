    "@hyperdx/node-opentelemetry": "^0.11.0",
    "@prisma/client": "6.0.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.58.5",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "ioredis": "5.11.1",
    "prisma": "6.0.1",
    "stripe": "^18.5.0",
    "zod": "^3.24.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.3",
    "eslint": "^9.39.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3",
    "vitest": "^5.0.2"
