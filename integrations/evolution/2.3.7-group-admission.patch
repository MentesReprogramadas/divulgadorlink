+  public async joinApprovalMode(update: GroupJoinApprovalDto) {
+    this.requireAdmissionConnection();
+    try {
+      await this.client.groupJoinApprovalMode(update.groupJid, update.enabled ? 'on' : 'off');
+      return { success: true };
+    } catch {
+      throw new BadRequestException('Unable to update group approval mode');
+    }
+  }
+  public async requestParticipants(group: GroupJid) {
+    this.requireAdmissionConnection();
+    try {
+      const pending = await this.client.groupRequestParticipantsList(group.groupJid);
+      return { participants: pending.map((participant) => participant.jid) };
+    } catch {
+      throw new BadRequestException('Unable to read group admission requests');
+    }
+  }
+  public async updateRequestParticipants(update: GroupRequestUpdateDto) {
+    this.requireAdmissionConnection();
+    try {
+      // Preserve LIDs; phone normalization would corrupt these identifiers.
+      const participants = await this.client.groupRequestParticipantsUpdate(
+        update.groupJid,
+        update.participants,
+        update.action,
+      );
+      return { participants };
+    } catch {
+      throw new BadRequestException('Unable to update group admission requests');
+    }
+  }
