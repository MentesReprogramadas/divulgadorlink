{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(www|links)\\.temlinkaqui\\.com"
        }
      ],
      "destination": "https://temlinkaqui.com/:path*",
      "statusCode": 308,
      "regex": "^(?!/_next)(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ],
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/bff/[...path]",
      "regex": "^/bff/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/bff/(?<nxtPpath>.+?)(?:/)?$"
    },
    {
      "page": "/go/[linkId]",
      "regex": "^/go/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPlinkId": "nxtPlinkId"
      },
      "namedRegex": "^/go/(?<nxtPlinkId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/link/[id]",
      "regex": "^/link/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/link/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/nicho/[slug]",
