# Variáveis lidas apenas no servidor Next (BFF). Nunca use prefixo NEXT_PUBLIC_ aqui.

# Origem da API Fastify para a qual o BFF encaminha as requisições.
# No Railway: http://<dominio-privado-da-api>:<PORT da api>
API_ORIGIN=http://127.0.0.1:3333

# Opcional. Força o header Host enviado à API, ignorando o host acessado no navegador.
# Útil para acessar via http://localhost:3000 e ainda cair num tenant existente.
# Deixe vazio para testar multi-tenant de verdade (tenant-a.localhost / tenant-b.localhost).
# NUNCA defina em produção: todos os tenants passariam a ser servidos como um só.
TENANT_HOST=
